
{
  "expo": {
    "name": "ClutchMetrics",
    "slug": "clutchmetrics-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/clutchmetrics-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080B13",
        "foregroundImage": "./assets/clutchmetrics-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/clutchmetrics-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video"
    ]
  }
}

